# ==============================================================================
# CIPHER: Global Environment Configuration
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
# ==============================================================================

# --- Cloud C2 Server (Attacker Console) ---
# The public IP or domain of your Cloud VM or machine running ./attack.sh
CLOUD_C2_URL=http://YOUR_C2_SERVER_IP:5000
PORT=5000

# --- Raspberry Pi Edge Gateway (Defender) ---
GATEWAY_PORT=5000
IFACE=wlan1

# --- Hotspot Credentials (Created on RPi for IoT devices) ---
HOTSPOT_SSID=Cipher_IoT_Net
HOTSPOT_PASSWORD=cipher2024

# --- Ngrok (Optional: if your gateway uses authenticated ngrok) ---
# NGROK_AUTHTOKEN=your_ngrok_token_here
